# =============================================================================
# Konfigurasi engine WhatsApp Beregam
#
# Salin menjadi .env di folder yang sama, lalu isi semuanya.
# Berkas .env TIDAK PERNAH ikut ter-commit.
# =============================================================================

# --- Image Docker OpenWA -----------------------------------------------------
#
# SENGAJA DIKOSONGKAN, dan ini perlu penjelasan.
#
# Rancangan di docs/plan.docx memilih OpenWA dan menyebut detail teknisnya
# (NestJS 11, TypeORM, Zod 4, lisensi MIT, port 2785, ENGINE_TYPE=baileys),
# tetapi tidak mencantumkan nama image Docker-nya. Menebak nama image untuk
# komponen yang memegang WhatsApp resmi instansi bukan hal yang pantas
# ditebak - salah tebak berarti menarik image milik orang lain yang tidak
# diketahui isinya.
#
# Cara mengisinya:
#   1. Buka dokumentasi resmi OpenWA
#   2. Catat nama image dan daftar versinya
#   3. Pilih SATU versi spesifik, jangan `latest`
#
# Contoh bentuk yang benar (bukan nilai sebenarnya):
#   OPENWA_IMAGE=nama-organisasi/openwa:0.18.0
#
OPENWA_IMAGE=

# --- Kunci API lokal ---------------------------------------------------------
# Melindungi API OpenWA di dalam PC. Bangkitkan dengan:
#   openssl rand -hex 32
OPENWA_API_KEY=

# --- Sambungan ke PESTA ------------------------------------------------------
# Tanpa garis miring di akhir.
# Untuk uji coba, arahkan ke staging lebih dulu, bukan produksi.
PESTA_BASE_URL=https://staging.bpskabmusirawas.com

# HMAC webhook. Nilainya HARUS SAMA PERSIS dengan BEREGAM_WEBHOOK_HMAC
# di Environment Variables Hostinger. Bangkitkan dengan:
#   openssl rand -hex 32
BEREGAM_WEBHOOK_HMAC=

# Peristiwa yang dikirim ke PESTA.
#
# session.restriction adalah peringatan dini bahwa WhatsApp mulai membatasi
# nomor ini - jauh lebih berguna diketahui sebelum nomornya benar-benar
# diblokir. Nama peristiwa persisnya dicocokkan dengan dokumentasi OpenWA.
OPENWA_WEBHOOK_EVENTS=message,session.status,session.restriction
