# =============================================================================
# Konfigurasi worker pesan Beregam
#
# Salin menjadi .env di folder yang sama, lalu isi semuanya.
# Berkas .env TIDAK PERNAH ikut ter-commit.
# =============================================================================

# --- Sambungan ke PESTA ------------------------------------------------------
# Tanpa garis miring di akhir.
PESTA_BASE_URL=https://staging.bpskabmusirawas.com

# Harus SAMA PERSIS dengan BEREGAM_API_KEY di Environment Variables Hostinger.
BEREGAM_API_KEY=

# --- Engine WhatsApp (di dalam PC ini) ---------------------------------------
WAHA_BASE_URL=http://127.0.0.1:3001
WAHA_API_KEY=
WAHA_SESSION=default

# --- Penanda worker ----------------------------------------------------------
# WAJIB BERBEDA di PC cadangan.
#
# Nilai ini dipakai untuk sewa kepemilikan: hanya pemegang sewa yang boleh
# memproses antrean. Bila kedua PC memakai nilai yang sama, keduanya akan
# saling merebut sewa dan warga bisa menerima pesan dobel.
WORKER_ID=worker-pc-utama

# --- Penyetelan (nilai bawaan sudah wajar) -----------------------------------
# POLL_INTERVAL_MS=3000
# HEARTBEAT_INTERVAL_MS=60000
# HTTP_TIMEOUT_MS=15000

# Jeda acak sebelum mengirim. Bagian dari aturan anti-blokir - mengirim tanpa
# jeda adalah jalur tercepat menuju nomor yang diblokir WhatsApp.
# JEDA_MIN_DETIK=3
# JEDA_MAX_DETIK=8

# debug | info | warn | error
# LOG_LEVEL=info

# --- Panel kendali lokal ----------------------------------------------------
# Panel SELALU mendengarkan di 127.0.0.1 saja; hanya portnya yang bisa diatur.
# Mengikat ke alamat lain sengaja tidak disediakan - panel bisa memutus
# tautan WhatsApp dan mematikan worker.
PANEL_PORT=3100

# Nama layanan systemd dan kontainer Docker yang dikendalikan panel.
# Ubah hanya kalau Anda memang menamainya berbeda.
NAMA_LAYANAN=beregam-worker
NAMA_KONTAINER=beregam-waha
