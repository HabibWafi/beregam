# =============================================================================
# Konfigurasi engine WhatsApp Beregam (WAHA)
#
# Salin menjadi .env di folder yang sama, lalu isi semuanya.
# Berkas .env TIDAK PERNAH ikut ter-commit.
# =============================================================================

# --- Image Docker ------------------------------------------------------------
# WAJIB tag versi spesifik, JANGAN PERNAH `latest`.
#
# WAHA masih mengeluarkan versi bertanggal. Kunci ke satu versi, lalu naikkan
# secara sadar: baca changelog -> uji di staging -> baru produksi.
#
# Varian `noweb-*` memakai baileys tanpa Chromium. Varian `chrome-*` menjalankan
# Chromium dan memakan 300-500 MB RAM lebih banyak tanpa manfaat di sini.
WAHA_IMAGE=devlikeapro/waha:noweb-2026.8.1

# Port di host. Bukan 3000, karena pada komputer pengembangan port itu sudah
# dipakai server Next.js PESTA. Di dalam container tetap 3000.
WAHA_PORT=3001

# --- Kunci API lokal ---------------------------------------------------------
# Melindungi API WAHA di dalam PC. Bangkitkan dengan:
#   openssl rand -hex 32
WAHA_API_KEY=

# --- Sambungan ke PESTA ------------------------------------------------------
# Tanpa garis miring di akhir.
# Untuk uji coba, arahkan ke staging lebih dulu, BUKAN produksi - percobaan
# pertama tidak boleh mengenai warga sungguhan.
PESTA_BASE_URL=https://staging.bpskabmusirawas.com

# HMAC webhook. Nilainya HARUS SAMA PERSIS dengan BEREGAM_WEBHOOK_HMAC di
# Environment Variables Hostinger. Kalau berbeda, PESTA menolak setiap
# webhook dengan 401 dan bot terlihat seperti "tidak menerima pesan sama
# sekali". Bangkitkan dengan:
#   openssl rand -hex 32
BEREGAM_WEBHOOK_HMAC=

# Peristiwa yang dikirim ke PESTA.
#
# session.status memberi tahu PESTA saat sesi WhatsApp bermasalah - jauh
# lebih berguna diketahui lewat dashboard daripada baru sadar karena tidak
# ada pesan masuk seharian.
WAHA_HOOK_EVENTS=message,session.status
